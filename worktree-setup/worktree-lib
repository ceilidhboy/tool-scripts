#!/bin/bash
# worktree-lib — shared path resolution for gaw's worktree tooling.
#
# Source this file; it defines functions and executes nothing. Both
# setup-worktree and post-merge-relink use it so that "where is the bundle
# root?" and "which worktree are packages shared from?" have exactly one
# answer in the codebase.
#
#   . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/worktree-lib"

# find_bundle_root <start-dir>
#   Walks up from <start-dir> towards the filesystem root looking for the
#   directory that contains .bare/. Prints that directory on success.
#   Returns 1 if no ancestor has a .bare/ directory.
#
#   Walking up (rather than assuming the parent) keeps worktrees created
#   outside the bundle — gaw -b feat/x ../elsewhere — working correctly.
find_bundle_root() {
    local dir="${1:-$PWD}"

    [ -d "$dir" ] || return 1
    dir="$(cd "$dir" && pwd -P)" || return 1

    while [ "$dir" != "/" ]; do
        if [ -d "$dir/.bare" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    return 1
}

# find_peer_worktree <bundle-root>
#   Prints the worktree to hardlink packages from: the first of master,
#   develop whose vendor/ is a real directory containing autoload.php.
#   Returns 1 if neither qualifies.
#
#   master is preferred over develop. A symlinked vendor/ is rejected so
#   that every worktree links directly to the source of truth instead of
#   chaining through an intermediate branch.
find_peer_worktree() {
    local bundle="${1:-}"
    local candidate peer

    [ -n "$bundle" ] && [ -d "$bundle" ] || return 1

    for candidate in master develop; do
        peer="$bundle/$candidate"
        if [ -f "$peer/vendor/autoload.php" ] && [ ! -L "$peer/vendor" ]; then
            printf '%s\n' "$peer"
            return 0
        fi
    done

    return 1
}

# ---- The setup flag list ----
# Flags that belong to setup-worktree. gaw must route these to setup-worktree
# rather than passing them to `git worktree add`, which rejects everything it
# does not recognise. This array is the only definition of that set: gaw
# routes by membership of it, setup-worktree implements the effects, and
# tests/test.sh asserts that the two stay in agreement — so adding a flag in
# one place without the other fails the suite instead of failing a user.
GAW_SETUP_FLAGS=(
    --full-install --no-packages
    --key --no-key
    --bun --npm --no-frontend
    --serena --no-serena
    --no-ceremony --review
    --dry-run
)

# is_setup_flag <flag>  — true (0) if <flag> belongs to setup-worktree.
is_setup_flag() {
    local flag
    for flag in "${GAW_SETUP_FLAGS[@]}"; do
        [ "$flag" = "${1:-}" ] && return 0
    done
    return 1
}
