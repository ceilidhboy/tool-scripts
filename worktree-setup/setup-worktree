#!/bin/bash
# setup-worktree — set up a Laravel worktree after checking it out
# Usage: setup-worktree [options] [<path>]
#
# Traverses up from the worktree root to find the parent .env file,
# then symlinks .env, copies .mcp.json (if absent), and handles
# Laravel bootstrapping — including smart package management.

set -euo pipefail

# ---- Config ----
FRONTEND="auto"   # auto | bun | npm | none
DRY_RUN=false
PACKAGE_MODE="auto"   # auto | full-install | no-packages
KEY_MODE="prompt"     # prompt | generate | skip

# ---- Helpers ----
info()  { printf "  \e[32m✓\e[0m %s\n" "$1"; }
warn()  { printf "  \e[33m⚠\e[0m %s\n" "$1"; }
err()   { printf "  \e[31m✗\e[0m %s\n" "$1" >&2; }
run() {
    if $DRY_RUN; then
        printf "  [dry-run] $\e[2m %s\e[0m\n" "$*"
    else
        "$@"
    fi
}

show_help() {
    cat >&1 <<'EOF'
Usage: setup-worktree [options] [<path>]

Sets up a Laravel worktree after checking it out.  If <path> is given,
cds there first.  Otherwise uses the current directory.

Package management (smart default):
  By default, setup-worktree looks for an existing develop or master
  worktree to symlink vendor/ and node_modules/ from, avoiding costly
  reinstalls.  If neither is found, a full install is performed.

Worktree autoload:
  If the laravel-worktree-autoload package is installed, runs
  php artisan worktree:init to ensure project_autoload.php exists,
  which corrects autoloader paths when vendor is symlinked.

Options:
  --full-install    Install packages directly (don't symlink from peer)
  --no-packages     Skip all package handling entirely
  --key             Auto-generate application key (no prompt)
  --no-key          Skip application key generation entirely
  --bun             Force bun install (even without bun.lock)
  --npm             Force npm install (even without package-lock.json)
  --no-frontend     Skip frontend dependency install
  --serena          Share .serena at bundle root across worktrees (seeds it if missing)
  --dry-run         Print what would be done without executing anything
  --help, -h        Show this message

Configuration (~/.config/gaw/config, key=value):
  share_serena=true  Share .serena at bundle root by default (no --serena flag needed)
EOF
    exit 0
}

usage() {
    cat >&2 <<'EOF'
Usage: setup-worktree [options] [<path>]

Run 'setup-worktree --help' for full usage.
EOF
    exit 1
}

# ---- Per-user config (~/.config/gaw/config) ----
# Optional key=value file read before argument parsing, so CLI flags win.
# Supported keys:
#   share_serena=true   share the bundle-root .serena across worktrees by default
GAW_CONFIG="${GAW_CONFIG:-$HOME/.config/gaw/config}"
if [ -f "$GAW_CONFIG" ]; then
    while IFS= read -r line; do
        case "$line" in
            share_serena=*) SERENA_SHARE="${line#share_serena=}" ;;
        esac
    done < "$GAW_CONFIG"
fi

# ---- Argument parsing ----
while [ $# -gt 0 ]; do
    case "$1" in
        --full-install)  PACKAGE_MODE="full-install"; shift ;;
        --no-packages)   PACKAGE_MODE="no-packages";  shift ;;
        --key)           KEY_MODE="generate";          shift ;;
        --no-key)        KEY_MODE="skip";              shift ;;
        --bun)           FRONTEND="bun";              shift ;;
        --npm)           FRONTEND="npm";              shift ;;
        --no-frontend)   FRONTEND="none";             shift ;;
        --serena)        SERENA_SHARE="true";          shift ;;
        --dry-run)       DRY_RUN=true;                shift ;;
        --help|-h)       show_help ;;
        --)              shift; break ;;
        -*)
            err "Unknown option: $1"
            usage
            ;;
        *)
            if [ -z "${worktree_path:-}" ]; then
                worktree_path="$1"
            else
                err "Unexpected argument: $1"
                usage
            fi
            shift
            ;;
    esac
done

# If a path was provided, cd to it
if [ -n "${worktree_path:-}" ]; then
    worktree_path="${worktree_path/#\~/$HOME}"
    cd "$worktree_path" || { err "Could not cd to '$worktree_path'"; exit 1; }
fi

WORKTREE_ROOT="$(pwd)"
echo "Worktree root: $WORKTREE_ROOT"

# Verify we're at a Laravel project root
if [ ! -f "$WORKTREE_ROOT/composer.json" ]; then
    echo ""
    echo "⚠  ATTENTION:"
    echo ""
    echo "This doesn't look like a Laravel project root (no composer.json found)."
    echo ""
    echo "If this is a new project, create the Laravel app first:"
    echo "  composer create-project laravel/laravel ."
    echo ""
    echo "Then run setup-worktree again to symlink .env, storage, etc."
    echo ""
    exit 0
fi

# ---- Find bundle root (directory containing .bare/) ----
BUNDLE_ROOT=""
target="$WORKTREE_ROOT"
while [ "$target" != "/" ]; do
    if [ -d "$target/.bare" ]; then
        BUNDLE_ROOT="$target"
        break
    fi
    target="$(dirname "$target")"
done

if [ -z "$BUNDLE_ROOT" ]; then
    err "Could not find a .bare directory in any parent directory."
    err "Make sure you've cloned the bare repo before creating worktrees:"
    err ""
    err "  git clone --bare <url> .bare"
    err "  echo 'gitdir: .bare' > .git"
    exit 1
fi

echo "Bundle root: $BUNDLE_ROOT"
echo ""

# ---- Bootstrap: .git at bundle root ----
if [ ! -f "$BUNDLE_ROOT/.git" ]; then
    echo 'gitdir: .bare' > "$BUNDLE_ROOT/.git"
    info "Created .git at bundle root"
fi

# ---- 1. Share .env across worktrees ----
# Goal: .env lives at bundle root, each worktree symlinks to it.
# Source can come from bundle root or worktree.

if [ -f "$BUNDLE_ROOT/.env" ] && [ ! -e "$WORKTREE_ROOT/.env" ]; then
    # Bundle has .env, worktree doesn't — symlink it
    run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_ROOT/.env")" "$WORKTREE_ROOT/.env"
    info "Symlinked .env"

elif [ -f "$WORKTREE_ROOT/.env" ] && [ ! -f "$BUNDLE_ROOT/.env" ]; then
    # Worktree has .env (e.g. from composer create-project), bundle doesn't — adopt it
    run mv "$WORKTREE_ROOT/.env" "$BUNDLE_ROOT/.env"
    run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_ROOT/.env")" "$WORKTREE_ROOT/.env"
    info "Adopted worktree .env as shared bundle source"

elif [ ! -f "$BUNDLE_ROOT/.env" ] && [ ! -f "$WORKTREE_ROOT/.env" ]; then
    # Neither has .env — try to create one from .env.example
    env_src=""
    [ -f "$BUNDLE_ROOT/.env.example" ] && env_src="$BUNDLE_ROOT/.env.example"
    [ -z "$env_src" ] && [ -f "$WORKTREE_ROOT/.env.example" ] && env_src="$WORKTREE_ROOT/.env.example"

    if [ -n "$env_src" ]; then
        run cp "$env_src" "$BUNDLE_ROOT/.env"
        run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_ROOT/.env")" "$WORKTREE_ROOT/.env"
        info "Created .env from $(basename "$env_src"), symlinked"
        echo "    Review and edit $BUNDLE_ROOT/.env with your secrets"
        echo "    Then run: php artisan key:generate"
    else
        echo ""
        echo "ℹ  No .env or .env.example found anywhere."
        echo ""
        echo "    If this is a new Laravel project, create .env manually:"
        echo "      cp .env.example .env"
        echo "      php artisan key:generate"
        echo ""
        exit 0
    fi
fi

# ---- 2. Symlink .mcp.json ----
MCP_MASTER="$HOME/.local/bin/.mcp.json"

if [ ! -e "$WORKTREE_ROOT/.mcp.json" ]; then
    if [ -f "$BUNDLE_ROOT/.mcp.json" ]; then
        run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_ROOT/.mcp.json")" "$WORKTREE_ROOT/.mcp.json"
        info "Symlinked .mcp.json → $BUNDLE_ROOT/.mcp.json"
    elif [ -f "$MCP_MASTER" ]; then
        run ln -s "$MCP_MASTER" "$WORKTREE_ROOT/.mcp.json"
        info "Symlinked .mcp.json → $HOME/.local/bin/.mcp.json"
    else
        warn "No .mcp.json found at bundle root or master copy ($MCP_MASTER)"
        warn "Create one at either location and re-run setup-worktree"
    fi
else
    warn ".mcp.json already exists in worktree — skipping"
fi

# ---- 3. Share .serena across worktrees (opt-in) ----
# If the user has set up a shared .serena at the bundle root (like .env and
# .mcp.json), each worktree symlinks to it so all worktrees of the repo share
# one project.yml + memories. Serena's symbol caches are content-hash keyed,
# so sharing is safe — stale entries auto-invalidate per worktree.
#
# Opt-in: pass --serena (seeds the bundle copy on first use) or create
# $BUNDLE_ROOT/.serena yourself. Team members who do neither are unaffected:
# their worktrees keep the repo's tracked .serena and no symlink or
# .gitignore change is made.

BUNDLE_SERENA="$BUNDLE_ROOT/.serena"
WT_SERENA="$WORKTREE_ROOT/.serena"

seed_serena_project_yml() {
    cat > "$1" <<EOF
# Auto-generated by setup-worktree — shared by all worktrees of this repo.
project_name: "$(basename "$BUNDLE_ROOT")"
languages:
- php
- typescript
- bash
EOF
}

append_gitignore_serena() {
    echo "/.serena/" >> "$1"
}

if [ "${SERENA_SHARE:-false}" = "true" ] || [ -d "$BUNDLE_SERENA" ]; then
    if [ -L "$WT_SERENA" ]; then
        if [ -e "$WT_SERENA" ]; then
            info ".serena already symlinked"
        else
            warn ".serena symlink is broken — re-creating"
            run rm "$WT_SERENA"
            run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_SERENA")" "$WT_SERENA"
            info "Re-symlinked .serena → $BUNDLE_SERENA"
        fi
    elif [ -d "$WT_SERENA" ]; then
        if [ -d "$BUNDLE_SERENA" ]; then
            warn ".serena exists as a real directory in BOTH this worktree and the bundle root."
            warn "  Auto-merge is not performed. Move memories manually if needed, e.g.:"
            warn "  rsync -a $WT_SERENA/memories/ $BUNDLE_SERENA/memories/"
            warn "  Then remove the worktree copy and re-run setup-worktree."
        else
            run mv "$WT_SERENA" "$BUNDLE_SERENA"
            run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_SERENA")" "$WT_SERENA"
            info "Adopted worktree .serena as shared bundle source"
        fi
    else
        if [ ! -d "$BUNDLE_SERENA" ]; then
            run mkdir -p "$BUNDLE_SERENA/memories"
            info "Created shared .serena at bundle root"
        fi
        if [ ! -f "$BUNDLE_SERENA/project.yml" ]; then
            run seed_serena_project_yml "$BUNDLE_SERENA/project.yml"
            info "Seeded project.yml (php/typescript/bash, project_name=$(basename "$BUNDLE_ROOT"))"
        fi
        run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$BUNDLE_SERENA")" "$WT_SERENA"
        info "Symlinked .serena → $BUNDLE_SERENA"
    fi

    # Keep .serena out of git status in symlinked worktrees (idempotent)
    if [ -f "$WORKTREE_ROOT/.gitignore" ] && ! grep -q '^/.serena/$' "$WORKTREE_ROOT/.gitignore"; then
        run append_gitignore_serena "$WORKTREE_ROOT/.gitignore"
        info "Added /.serena/ to .gitignore"
    fi
else
    info "No shared .serena at bundle root — keeping the worktree's tracked .serena (no symlink)"
fi

# ---- 4. Package handling ----
echo ""

# Define the full install routine (used by --full-install and auto fallback)
do_full_install() {
    # composer install
    if [ -f "$WORKTREE_ROOT/composer.json" ]; then
        echo ""
        echo "--- composer install ---"
        run composer install
        info "composer install completed"
    else
        warn "No composer.json found, skipping composer install"
    fi

    # Frontend dependencies
    echo ""
    echo "--- Frontend dependencies ---"

    install_frontend() {
        local manager="$1"
        local lockfile="$2"
        local install_cmd="$3"

        if [ -f "$WORKTREE_ROOT/$lockfile" ] || [ "$FRONTEND" = "$manager" ]; then
            echo "Detected $manager ($lockfile) — running $install_cmd"
            run $install_cmd
            info "$install_cmd completed"
            return 0
        fi
        return 1
    }

    case "$FRONTEND" in
        auto)
            install_frontend "bun"  "bun.lock"      "bun install --frozen-lockfile"  ||
            install_frontend "bun"  "bun.lockb"     "bun install --frozen-lockfile"  ||
            install_frontend "npm"  "package-lock.json" "npm ci" ||
            install_frontend "yarn" "yarn.lock"      "yarn install --frozen-lockfile" ||
            install_frontend "pnpm" "pnpm-lock.yaml" "pnpm install --frozen-lockfile" ||
                { [ -f "$WORKTREE_ROOT/package.json" ] && \
                  warn "package.json found but no lockfile — skipping"; } || true
            ;;
        bun)
            run bun install --frozen-lockfile
            info "bun install --frozen-lockfile completed"
            ;;
        npm)
            run npm ci
            info "npm ci completed"
            ;;
        none)
            echo "Skipping frontend install (--no-frontend)"
            ;;
    esac
}

case "$PACKAGE_MODE" in
    no-packages)
        echo "--- Skipping all package handling (--no-packages) ---"
        ;;

    full-install)
        echo "--- Full install mode (--full-install) ---"
        do_full_install
        ;;

    auto)
        # Smart default: look for a peer worktree to symlink from
        # Checks master first (preferred), then develop.
        # Prefers a candidate whose vendor/ is a real directory (not a symlink
        # pointing at another branch), so every worktree links directly to the
        # source of truth rather than chaining through an intermediate branch.
        PACKAGE_SOURCE=""
        PACKAGE_SOURCE_FALLBACK=""
        for candidate in "master" "develop"; do
            candidate_dir="$BUNDLE_ROOT/$candidate"
            if [ -f "$candidate_dir/vendor/autoload.php" ]; then
                if [ ! -L "$candidate_dir/vendor" ]; then
                    PACKAGE_SOURCE="$candidate_dir"
                    echo "Found package source: $PACKAGE_SOURCE (real packages)"
                    break
                else
                    # vendor is a symlink — save as fallback in case no branch
                    # has real packages
                    [ -z "$PACKAGE_SOURCE_FALLBACK" ] && PACKAGE_SOURCE_FALLBACK="$candidate_dir"
                fi
            fi
        done

        if [ -z "$PACKAGE_SOURCE" ] && [ -n "$PACKAGE_SOURCE_FALLBACK" ]; then
            PACKAGE_SOURCE="$PACKAGE_SOURCE_FALLBACK"
            echo "Found package source: $PACKAGE_SOURCE (via symlink)"
        fi

        if [ -n "$PACKAGE_SOURCE" ]; then
            echo "--- Symlinking packages from $(basename "$PACKAGE_SOURCE") ---"

            # Symlink vendor
            if [ -e "$WORKTREE_ROOT/vendor" ]; then
                warn "vendor already exists — skipping symlink"
            else
                run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$PACKAGE_SOURCE/vendor")" "$WORKTREE_ROOT/vendor"
                info "Symlinked vendor → $PACKAGE_SOURCE/vendor"
            fi

            # Symlink node_modules (if it exists in the source)
            if [ -d "$PACKAGE_SOURCE/node_modules" ]; then
                if [ -e "$WORKTREE_ROOT/node_modules" ]; then
                    warn "node_modules already exists — skipping symlink"
                else
                    run ln -s "$(realpath --relative-to="$WORKTREE_ROOT" "$PACKAGE_SOURCE/node_modules")" "$WORKTREE_ROOT/node_modules"
                    info "Symlinked node_modules → $PACKAGE_SOURCE/node_modules"
                fi
            else
                warn "node_modules not found in source — skipping symlink"
            fi
        else
            echo "--- No package source found — performing full install ---"
            do_full_install
        fi
        ;;
esac

# ---- 5. Worktree autoload bootstrap ----
# If the laravel-worktree-autoload package is installed, run its
# init command to ensure project_autoload.php exists (idempotent).
if [ -f "$WORKTREE_ROOT/artisan" ]; then
    echo ""
    echo "--- Worktree autoload bootstrap ---"

    if php artisan list worktree:init >/dev/null 2>&1; then
        run php artisan worktree:init
        info "worktree:init completed"
    else
        warn "Package 'ceilidhboy/laravel-worktree-autoload' is not installed."
        warn "Without it, each worktree will need the autoload wrapper at"
        warn "project_autoload.php to handle symlinked vendor paths correctly."
        warn ""
        warn "  cd \$(dirname \$(find-up \$(dirname \$(find-up .bare)))/master)"
        warn "  composer require --dev ceilidhboy/laravel-worktree-autoload"
        warn "  php artisan worktree:init"
        warn "  git add -A && git commit -m 'Add worktree autoload support'"
        warn "  git push"
    fi
fi

# ---- 6. php artisan storage:link ----
if [ -f "$WORKTREE_ROOT/artisan" ]; then
    echo ""
    echo "--- php artisan storage:link ---"
    run php artisan storage:link
    info "storage:link completed"
else
    warn "No artisan found, skipping storage:link"
fi

# ---- 7. php artisan key:generate ----
if [ "$KEY_MODE" != "skip" ] && [ -f "$WORKTREE_ROOT/artisan" ]; then
    echo ""
    echo "--- Application key ---"

    # Check if .env already has an APP_KEY set
    current_key=$(grep '^APP_KEY=' "$WORKTREE_ROOT/.env" 2>/dev/null || true)
    if [ -n "$current_key" ] && [ "$current_key" != 'APP_KEY=' ]; then
        info "APP_KEY already set — skipping key generation"
    elif [ "$KEY_MODE" = "generate" ]; then
        run php artisan key:generate
        info "Application key generated"
    elif [ "$KEY_MODE" = "prompt" ]; then
        printf "  Would you like to generate an application key? [Y/n]: "
        if ! read -r answer < /dev/tty 2>/dev/null; then
            warn "Not a terminal — skipping key generation prompt"
            warn "Run 'php artisan key:generate' manually when ready"
        else
            case "${answer:-Y}" in
                [Nn]*)
                    warn "Skipping key generation"
                    warn "You can generate one later with: php artisan key:generate"
                    ;;
                *)
                    run php artisan key:generate
                    info "Application key generated"
                    ;;
            esac
        fi
    fi
fi

# ---- Done ----
echo ""
echo "============================================"
echo "  Worktree setup complete!"
echo "============================================"
