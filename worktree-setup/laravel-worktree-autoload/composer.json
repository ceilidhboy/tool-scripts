{
    "name": "ceilidhboy/laravel-worktree-autoload",
    "description": "Makes Laravel projects worktree-aware when vendor/ is symlinked to a shared directory.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mike Scott",
            "email": "ceilidhboy@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ceilidhboy\\WorktreeAutoload\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ceilidhboy\\WorktreeAutoload\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
