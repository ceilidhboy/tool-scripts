#!/bin/bash
# gaw — git add worktree wrapper
# Usage: gaw [options] <path> [<branch>]
#
# Creates a new git worktree, then runs setup-worktree from it.

set -euo pipefail

# ---- Init helper ----
# Used by --init to bootstrap a bare repo + .git pointer at the bundle root.
# Usage: do_init [<path>] [<url>]
do_init() {
    local init_path="" init_url=""
    local parsed=false

    # Parse positional args, skip --init itself
    for arg in "$@"; do
        if [ "$arg" = "--init" ] && ! $parsed; then
            parsed=true
            continue
        fi
        if [ -z "$init_path" ]; then
            init_path="$arg"
        elif [ -z "$init_url" ]; then
            init_url="$arg"
        fi
    done

    # Determine target directory
    init_path="${init_path:-$PWD}"
    init_path="${init_path/#\~/$HOME}"

    # Ensure it exists
    mkdir -p "$init_path"
    cd "$init_path"

    echo "Initialising at: $init_path"
    echo ""

    # ---- 1. Bare repo ----
    if [ -d ".bare" ]; then
        echo "  ✓ .bare/ already exists — leaving it alone"
    elif [ -n "$init_url" ]; then
        echo "  Cloning bare repo from $init_url ..."
        git clone --bare "$init_url" .bare
        echo "  ✓ Cloned bare repo from $init_url"
    else
        git init --bare .bare
        echo "  ✓ Created new bare repository"
    fi

    # ---- 2. .git pointer ----
    if [ -e ".git" ]; then
        echo "  ⚠ .git already exists — leaving it alone"
    else
        echo 'gitdir: .bare' > .git
        echo "  ✓ Created .git pointer → .bare"
    fi

    # ---- 3. Initial commit (if repo is empty) ----
    # Use GIT_DIR to bypass bare repo restriction for checking/creating commits
    if ! GIT_DIR=.bare git rev-parse HEAD >/dev/null 2>&1; then
        echo ""
        echo "  --- Creating initial commit ---"

        # Gather everything that exists, excluding .bare
        local existing_files=()
        for f in * .*; do
            [ "$f" = "." ] || [ "$f" = ".." ] || [ "$f" = ".bare" ] || [ "$f" = ".git" ] && continue
            existing_files+=("$f")
        done

        if [ ${#existing_files[@]} -eq 0 ]; then
            # Empty directory — create a README as a starting point
            cat > README.md <<'INITEOF'
# Project

Initialised by gaw --init
INITEOF
            echo "  ✓ Created README.md"
        fi

        # Use GIT_DIR/GIT_WORK_TREE to bypass bare repo restriction
        GIT_DIR=.bare GIT_WORK_TREE=. git add --all -- ':!.bare' ':!.git'
        GIT_DIR=.bare GIT_WORK_TREE=. git commit -m "Initial commit"
        echo "  ✓ Created initial commit"
    else
        echo "  ✓ Repository already has commits"
    fi

    echo ""
    echo "============================================"
    echo "  gaw --init complete!"
    echo "============================================"
    echo ""
    echo "  You can now create worktrees with:"
    echo "    gaw develop main"
    echo "    gaw feat/my-feature"
    echo ""
    exit 0
}

show_help() {
    cat >&1 <<'EOF'
Usage: gaw [options] <path> [<branch>]

Creates a new git worktree and runs setup-worktree on it.
All unrecognised arguments are passed through to 'git worktree add'.

Options:
  --init [<path>] [<url>]   Bootstrap a bare repo + .git pointer at <path>
                              (defaults to current directory). If <url> is given,
                              clones it as a bare repo; otherwise creates a new one.
                              If .bare/ already exists, it is left alone.
                              Creates an initial commit if the repo is empty.
  --full-install            Install packages directly instead of symlinking
  --no-packages             Skip all package handling (no symlink, no install)
  --key                     Auto-generate application key (passes through to setup-worktree)
  --no-key                  Skip application key generation (passes through to setup-worktree)
  --help, -h                Show this help message

Examples:
  gaw --init                      # init current directory with new bare repo
  gaw --init ~/projects/my-app    # init at a specific path
  gaw --init ~/projects/my-app git@github.com:user/repo.git  # clone bare from remote
  gaw feat/new-feature            # worktree at feat/new-feature for branch feat/new-feature
  gaw develop main                # worktree at develop from branch main
  gaw --detach feat/experiment    # detached worktree
EOF
    exit 0
}

usage() {
    cat >&2 <<'EOF'
Usage: gaw [options] <path> [<branch>]

Creates a new git worktree and runs setup-worktree on it.

Run 'gaw --help' for full usage.
EOF
    exit 1
}

# ---- Check for --init (handled before main parsing) ----
for arg in "$@"; do
    if [ "$arg" = "--init" ]; then
        do_init "$@"
        exit $?
    fi
done

# ---- Separate setup-worktree flags from git worktree add flags ----
setup_flags=()
git_args=()
path=""
skip_next=false
after_double_dash=false

for arg in "$@"; do
    if $skip_next; then
        git_args+=("$arg")
        skip_next=false
        continue
    fi
    if $after_double_dash; then
        git_args+=("$arg")
        continue
    fi
    case "$arg" in
        --full-install|--no-packages|--key|--no-key)
            setup_flags+=("$arg")
            ;;
        --help|-h)
            show_help
            ;;
        -b|-B|--branch|--reason)
            git_args+=("$arg")
            skip_next=true
            ;;
        --)
            git_args+=("$arg")
            after_double_dash=true
            ;;
        -*)
            git_args+=("$arg")
            ;;
        *)
            if [ -z "$path" ]; then
                path="$arg"
            fi
            git_args+=("$arg")
            ;;
    esac
done

if [ -z "$path" ]; then
    echo "Error: no path specified." >&2
    usage
fi

# Expand leading tilde in path (e.g., ~/projects/foo)
path="${path/#\~/$HOME}"

# ---- Create the worktree ----
# If only one positional arg (just a path), create the branch with the full path name,
# not just git's default basename (which would strip 'feature/', 'bugfix/', etc.).
if [ ${#git_args[@]} -eq 1 ]; then
    branch="${git_args[0]}"
    if git rev-parse --verify "$branch" >/dev/null 2>&1; then
        # Branch already exists — just check it out
        git worktree add "$branch" "$branch"
    elif git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
        # Remote tracking branch exists — create local branch tracking it
        git worktree add -b "$branch" "$branch" "origin/$branch"
    else
        # Create new branch from HEAD
        git worktree add -b "$branch" "$branch"
    fi
else
    git worktree add "${git_args[@]}"
fi

# ---- Run setup ----
exec setup-worktree "${setup_flags[@]}" "$path"
