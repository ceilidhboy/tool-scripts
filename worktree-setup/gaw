#!/bin/bash
# gaw — git add worktree wrapper
# Usage: gaw [options] <path> [<branch>]
#
# Creates a new git worktree, then runs setup-worktree from it.

set -euo pipefail

# ---- Helpers ----
warn() { printf "  \e[33m⚠\e[0m %s\n" "$1" >&2; }

# ---- Init helper ----
# Used by --init to bootstrap a bare repo + .git pointer at the bundle root.
# Usage: do_init [<path>] [<url>]
do_init() {
    local init_path=""
    local parsed=false

    # Parse positional args, skip --init itself
    for arg in "$@"; do
        if [ "$arg" = "--init" ] && ! $parsed; then
            parsed=true
            continue
        fi
        if [ -z "$init_path" ]; then
            init_path="$arg"
        fi
    done

    # Determine target directory
    init_path="${init_path:-$PWD}"
    init_path="${init_path/#\~/$HOME}"

    # Ensure it exists
    mkdir -p "$init_path"
    cd "$init_path"

    echo "Initialising at: $init_path"
    echo ""

    # ---- 1. Check bare repo ----
    if [ ! -d ".bare" ]; then
        echo "⚠  No .bare/ directory found."
        echo ""
        echo "First, clone the bare repo from GitHub:"
        echo "  git clone --bare git@github.com:Socially-Free/<repo>.git .bare"
        echo ""
        echo "Then run gaw --init again."
        echo "  (gaw --init sets remote.origin.fetch automatically — bare clones omit it)"
        exit 1
    fi

    echo "  ✓ .bare/ found"

    # ---- 2. .git pointer ----
    if [ -e ".git" ]; then
        echo "  ✓ .git pointer already exists"
    else
        echo 'gitdir: .bare' > .git
        echo "  ✓ Created .git pointer → .bare"
    fi

    # ---- 3. Ensure fetch refspec ----
    # git clone --bare omits remote.origin.fetch, silently breaking all
    # origin/* comparisons. Repair it if missing.
    if ! git config --get remote.origin.fetch >/dev/null 2>&1; then
        git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
        echo "  ✓ Set remote.origin.fetch (bare clone omits it)"
    else
        echo "  ✓ remote.origin.fetch already set"
    fi

    echo ""
    echo "Ready. You can now create worktrees:"
    echo "  gaw develop"
    echo "  gaw feat/my-feature"
    echo ""

    echo "─────────────────── Recommended ───────────────────"
    echo ""
    echo "Create a master worktree first, then child worktrees:"
    echo ""
    echo "  gaw master"
    echo "  gaw feat/my-feature"
    echo ""
    echo "setup-worktree hardlink-copies vendor/ and node_modules/ from"
    echo "master into each new worktree (copy-on-write: shared package code,"
    echo "per-worktree composer data), so child worktrees are cheap to create."
    echo ""
    exit 0
}

show_help() {
    cat >&1 <<'EOF'
Usage: gaw [options] <path> [<branch>]

Creates a new git worktree and runs setup-worktree on it.
All unrecognised arguments are passed through to 'git worktree add'.

Options:
  --init [<path>]           Ensure .git pointer exists at <path> (defaults to
                              current directory). Checks .bare/ exists first and
                              instructs you to clone it if not.
  --full-install            Install packages directly instead of hardlink sharing
  --no-packages             Skip all package handling entirely
  --key                     Auto-generate application key (passes through to setup-worktree)
  --no-key                  Skip key generation (passes through to setup-worktree)
  --serena                  Share .serena at bundle root across worktrees (passes through to setup-worktree)
  --help, -h                Show this help message

Configuration: set share_serena=true in ~/.config/gaw/config to enable it by default.

Examples:
  gaw --init                      # ensure .git pointer exists in current dir
  gaw --init ~/projects/my-app    # ensure .git pointer at a specific path
  gaw feat/new-feature            # worktree at feat/new-feature for branch feat/new-feature
  gaw develop                    # create develop branch + worktree from HEAD
  gaw --detach feat/experiment    # detached worktree
EOF
    exit 0
}

usage() {
    cat >&2 <<'EOF'
Usage: gaw [options] <path> [<branch>]

Creates a new git worktree and runs setup-worktree on it.

Run 'gaw --help' for full usage.
EOF
    exit 1
}

# ---- Check for --init (handled before main parsing) ----
for arg in "$@"; do
    if [ "$arg" = "--init" ]; then
        do_init "$@"
        exit $?
    fi
done

# ---- Separate setup-worktree flags from git worktree add flags ----
setup_flags=()
git_args=()
path=""
skip_next=false
after_double_dash=false

for arg in "$@"; do
    if $skip_next; then
        git_args+=("$arg")
        skip_next=false
        continue
    fi
    if $after_double_dash; then
        git_args+=("$arg")
        continue
    fi
    case "$arg" in
        --full-install|--no-packages|--key|--no-key|--serena)
            setup_flags+=("$arg")
            ;;
        --help|-h)
            show_help
            ;;
        -b|-B|--branch|--reason)
            git_args+=("$arg")
            skip_next=true
            ;;
        --)
            git_args+=("$arg")
            after_double_dash=true
            ;;
        -*)
            git_args+=("$arg")
            ;;
        *)
            if [ -z "$path" ]; then
                path="$arg"
            fi
            git_args+=("$arg")
            ;;
    esac
done

if [ -z "$path" ]; then
    echo "Error: no path specified." >&2
    usage
fi

# Expand leading tilde in path (e.g., ~/projects/foo)
path="${path/#\~/$HOME}"

# ---- Create the worktree ----
# Ensure the fetch refspec exists (bare clones omit it), else origin/* refs
# silently go stale and every comparison against the remote lies.
if ! git config --get remote.origin.fetch >/dev/null 2>&1; then
    git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    warn "remote.origin.fetch was missing — set it (bare clone omission)"
fi
# Always fetch first so remote tracking branches and local branches are current
git fetch origin 2>/dev/null || true

# If only one positional arg (just a path), create the branch with the full path name,
# not just git's default basename (which would strip 'feature/', 'bugfix/', etc.).
if [ ${#git_args[@]} -eq 1 ]; then
    branch="${git_args[0]}"
    if git rev-parse --verify "$branch" >/dev/null 2>&1; then
        # Branch already exists — fast-forward from remote if tracking it, then check it out.
        # Uses update-ref rather than fetch because fetch refuses to update a ref that is
        # checked out in another worktree, whereas update-ref operates on the bare repo directly.
        if git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
            if git merge-base --is-ancestor "$branch" "origin/$branch" 2>/dev/null; then
                # Local is behind remote in a straight line — fast-forward it
                git update-ref "refs/heads/$branch" "refs/remotes/origin/$branch" 2>/dev/null || true
            elif git merge-base --is-ancestor "origin/$branch" "$branch" 2>/dev/null; then
                # Local is ahead of remote — nothing to do
                :
            else
                # Diverged — remote has been rebased or force-pushed
                warn "Branch '$branch' has DIVERGED from origin/$branch."
                warn "  The remote was likely rebased or force-pushed."
                warn "  Your local branch has $(git rev-list --count "origin/$branch..$branch" 2>/dev/null || echo '?') commits not on the remote."
                warn "  The remote has $(git rev-list --count "$branch..origin/$branch" 2>/dev/null || echo '?') commits not in your local."
                warn ""
                warn "  To discard your local and use the remote version:"
                warn "    git reset --hard origin/$branch"
                warn ""
                warn "  Creating worktree from YOUR LOCAL version (the stale one)."
                warn "  Run the reset command above inside the new worktree if you want the remote version."
            fi
        fi
        git worktree add "$branch" "$branch"
    elif git rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
        # Remote tracking branch exists — create local branch tracking it
        git worktree add -b "$branch" "$branch" "origin/$branch"
    else
        # Create new branch from HEAD
        git worktree add -b "$branch" "$branch"
    fi
else
    git worktree add "${git_args[@]}"
fi

# ---- Run setup ----
exec setup-worktree "${setup_flags[@]}" "$path"
